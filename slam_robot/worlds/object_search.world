<?xml version="1.0" ?>
<!-- object_search_world: two rooms joined by a 3 m doorway (walls: 11.85 x 7 m, 2.5 m high).
     Robot start (set in simulation.launch.py): x=-3.0, y=-2.0 in the west room.
     Target: red_box in the east room, hidden behind the partition.
     Distractors: blue_box_1/2/3, blue_cylinder_1, blue_crate_1. -->
<sdf version="1.6">
  <world name="object_search_world">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0 -0.5 14 0 1.5 1.5708</pose>
      </camera>
    </gui>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Walls and partition (your hand-built layout, centred on the origin) -->
    <model name="object_search_walls">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="Wall_0">
        <pose>-5.85 0 0 0 0 -1.5708</pose>
        <collision name="Wall_0_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>7 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_0_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>7 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_1">
        <pose>-2.925 -3.425 0 0 0 0</pose>
        <collision name="Wall_1_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_1_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_2">
        <pose>0 -2.5 0 0 0 1.5708</pose>
        <collision name="Wall_2_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_2_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>2 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_4">
        <pose>2.925 -3.425 0 0 0 0</pose>
        <collision name="Wall_4_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_4_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_5">
        <pose>5.85 0 0 0 0 1.5708</pose>
        <collision name="Wall_5_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>7 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_5_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>7 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_6">
        <pose>2.925 3.425 0 0 0 3.14159</pose>
        <collision name="Wall_6_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_6_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_7">
        <pose>0 2.5 0 0 0 -1.5708</pose>
        <collision name="Wall_7_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>2 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_7_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>2 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
      <link name="Wall_9">
        <pose>-2.925 3.425 0 0 0 0</pose>
        <collision name="Wall_9_collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry></collision>
        <visual name="Wall_9_visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>6 0.15 2.5</size></box></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Grey obstacles -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>-4.4 1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cylinder_2">
      <static>true</static>
      <pose>2.0 1.9 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="sphere_1">
      <static>true</static>
      <pose>2.4 -1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>-2.0 1.0 0.3 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.5 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 0.6</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Blue distractors (same colour family, different shapes and sizes) -->
    <model name="blue_box_1">
      <static>true</static>
      <pose>-1.0 -1.7 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.3</size></box></geometry><material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_box_2">
      <static>true</static>
      <pose>3.5 2.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.3</size></box></geometry><material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_box_3">
      <static>true</static>
      <pose>-2.5 2.7 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.3</size></box></geometry><material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_cylinder_1">
      <static>true</static>
      <pose>-4.6 -2.6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry><material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blue_crate_1">
      <static>true</static>
      <pose>4.6 0.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Target: the only red object -->
    <model name="red_box">
      <static>true</static>
      <pose>4.5 -2.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.3 0.3</size></box></geometry><material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
